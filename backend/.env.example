# MySQL (optional overrides; defaults match core/settings.py)
# MYSQL_DATABASE=my_db
# MYSQL_USER=abel
# MYSQL_PASSWORD=
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306

# Clerk JWT verification (required for production API auth)
# From Clerk Dashboard → Configure → API keys → JWT verification / JWKS URL
CLERK_JWKS_URL=
# Issuer URL(s) from the same JWT verification screen. You may list several comma-separated
# variants if Clerk’s token `iss` differs slightly (e.g. dev vs proxy).
CLERK_ISSUER=
# Only if your Clerk JWTs include an audience claim you must match
# CLERK_AUDIENCE=

# Comma-separated Clerk user ids (JWT "sub") that get ADMIN on first profile sync
# BOOTSTRAP_ADMIN_CLERK_IDS=user_2abc...

# CRM HS256 API tokens (POST /api/auth/crm-token/ after Clerk sign-in). Defaults to DJANGO_SECRET_KEY if unset.
# CRM_JWT_SECRET=
# CRM_JWT_ISSUER=crm-backend
# CRM_JWT_AUDIENCE=crm-api
# CRM_ACCESS_TOKEN_LIFETIME_SECONDS=3600
